# Clinical Trial Matcher — Environment Configuration
# Copy this file to .env and fill in values

# Ollama (local LLM inference)
TRIAL_MATCHER_OLLAMA_BASE_URL=http://localhost:11434
TRIAL_MATCHER_OLLAMA_MODEL=llama3.1:8b
TRIAL_MATCHER_OLLAMA_TIMEOUT_SECS=120

# Demo mode: set to true on Streamlit Cloud (no Ollama available)
TRIAL_MATCHER_DEMO_MODE=false

# Confidence thresholds
TRIAL_MATCHER_ABSTENTION_CONFIDENCE_THRESHOLD=0.35
TRIAL_MATCHER_HIGH_CONFIDENCE_THRESHOLD=0.80

# ClinicalTrials.gov API (no auth required)
TRIAL_MATCHER_CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2

# Data paths
TRIAL_MATCHER_N2C2_DATA_DIR=data/raw/n2c2_2018
TRIAL_MATCHER_RESULTS_DIR=results

# MIMIC-IV PostgreSQL (optional, for structured patient data)
# TRIAL_MATCHER_MIMIC_DB_URL=postgresql://user:pass@localhost:5432/mimic4

# PhysioNet credentials (for MIMIC download)
# PHYSIONET_USERNAME=
# PHYSIONET_PASSWORD=
