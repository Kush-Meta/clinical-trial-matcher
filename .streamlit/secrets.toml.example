# Streamlit Cloud secrets — copy contents into the Streamlit Cloud secrets panel

# ── Live mode (recommended) ───────────────────────────────────────────────────
# Get a free key at https://console.groq.com — no credit card required
TRIAL_MATCHER_GROQ_API_KEY = "gsk_your_key_here"
TRIAL_MATCHER_LLM_BACKEND = "groq"
TRIAL_MATCHER_GROQ_MODEL = "llama-3.1-8b-instant"
TRIAL_MATCHER_DEMO_MODE = "false"

# ── Or keep demo mode (no LLM key needed) ─────────────────────────────────────
# TRIAL_MATCHER_DEMO_MODE = "true"

# ── Confidence thresholds (optional — these are the defaults) ─────────────────
# TRIAL_MATCHER_ABSTENTION_CONFIDENCE_THRESHOLD = "0.35"
# TRIAL_MATCHER_HIGH_CONFIDENCE_THRESHOLD = "0.80"
